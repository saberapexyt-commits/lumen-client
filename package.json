{
  "name": "lumen-client",
  "productName": "Lumen Client",
  "version": "0.2.3",
  "description": "Minecraft launcher with a built-in CurseForge + Modrinth mod manager",
  "main": "dist/main/index.js",
  "license": "MIT",
  "scripts": {
    "build": "tsc -p . && node scripts/copy-renderer.js",
    "start": "npm run build && electron .",
    "test": "npm run build && node --test \"dist/tests/*.test.js\"",
    "smoke": "npm run build && node dist/tests/smoke/network-smoke.js",
    "dist": "npm run build && electron-builder",
    "pack": "npm run build && electron-builder --dir"
  },
  "build": {
    "appId": "dev.lumen.client",
    "files": [
      "dist/**/*",
      "package.json",
      "!dist/tests/**"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png"
    },
    "mac": {
      "target": [
        "dmg"
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ]
    },
    "directories": {
      "output": "release"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "saberapexyt-commits",
        "repo": "lumen-client"
      }
    ],
    "nsis": {
      "oneClick": true,
      "perMachine": false
    }
  },
  "dependencies": {
    "adm-zip": "^0.6.1",
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/node": "^26.6.5",
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "typescript": "^7.0.2"
  },
  "author": "Lumen Client contributors",
  "repository": {
    "type": "git",
    "url": "https://github.com/saberapexyt-commits/lumen-client.git"
  }
}